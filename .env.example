# SQL Server SA password. Must satisfy SQL Server complexity rules:
# at least 8 characters, with uppercase, lowercase, number, and symbol.
MSSQL_SA_PASSWORD=Dev_Password_123!

# RabbitMQ (optional for Milestone 7 messaging)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Enable transactional outbox + RabbitMQ in the API (Development uses true in appsettings.Development.json)
# Messaging__Enabled=true
# Messaging__HostName=localhost
# Messaging__Port=5672
